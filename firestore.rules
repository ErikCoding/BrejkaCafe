rules_version = '2';

/**
 * Firestore rules for Brëjka Café.
 *
 * Data model: a single document at cafes/brejka holding everything
 * the site renders (café info, hours, menu, gallery, social links) —
 * see DEFAULT_DATA in js/data.js for the exact shape.
 *
 * Policy:
 *   - Anyone can READ the document (it's a public marketing site —
 *     the menu and hours need to be visible with no login).
 *   - Only the café's admin account can WRITE to it (edits made from
 *     /admin.html after signing in with Firebase Authentication).
 *
 * Before deploying, replace ADMIN_UID below with the real Firebase
 * Auth UID of the admin account:
 *   1. Firebase Console → Authentication → Users → add a user
 *      (email + password) for the café owner.
 *   2. Copy that user's UID (shown in the Users table).
 *   3. Paste it in place of "REPLACE_WITH_ADMIN_UID" below.
 *
 * A UID match is used instead of an email match so the rules don't
 * leak the admin's email address inside client-readable rule text.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
